                                                >Web Development</span
                                            >
                                            <span class="skill-tag"
                                                >Community Building</span
                                            >
                                        </div>
                                    </div>
                                </div>

                                <div class="timeline-item">
                                    <div class="timeline-dot"></div>
                                    <div class="timeline-content">
                                        <span class="timeline-date"
                                            >Aug 2023 - May 2025</span
                                        >
                                        <h3 class="timeline-title">
                                            Co-President & Co-Founder
                                        </h3>
                                        <p class="timeline-org">
                                            Students in Data Science and
                                            Statistics (SDSS) UofT
                                        </p>
                                        <p class="timeline-desc">
                                            Leading 25+ executives and 200+
                                            members. Organized UofT's first
                                            datathon with 100+ attendees and
                                            developed club website for enhanced
                                            engagement.
                                        </p>
                                        <div class="skills">
                                            <span class="skill-tag"
                                                >Leadership</span
                                            >
                                            <span class="skill-tag"
                                                >Event Management</span
                                            >
                                            <span class="skill-tag"
                                                >Web Development</span
                                            >
                                            <span class="skill-tag"
                                                >Community Building</span
                                            >
                                        </div>
                                    </div>
                                </div>

                                <div class="timeline-item">
                                    <div class="timeline-dot"></div>
                                    <div class="timeline-content">
                                        <span class="timeline-date"
                                            >May 2024 - Aug 2024</span
                                        >
                                        <h3 class="timeline-title">
                                            Software Developer Intern
                                        </h3>
                                        <p class="timeline-org">
                                            RBC Amplify Internship Program
                                        </p>
                                        <p class="timeline-desc">
                                            Created end-to-end mortgage
                                            application system with 2%
                                            conversion increase and $11.5MM
                                            projected revenue. Won Overall Best
                                            Business Value Award ($20,000) using
                                            GPT-2 fine-tuning.
                                        </p>
                                        <div class="skills">
                                            <span class="skill-tag">RAFT</span>
                                            <span class="skill-tag">Python</span
                                            >
                                            <span class="skill-tag"
                                                >Product Development</span
                                            >
                                            <span class="skill-tag"
                                                >Fintech</span
                                            >
                                        </div>
                                    </div>
                                </div>

                                <!-- Projects -->
                                <div class="timeline-item">
                                    <div class="timeline-dot"></div>
                                    <div class="timeline-content">
                                        <span class="timeline-date"
                                            >Jan 2025 - April 2025</span
                                        >
                                        <h3 class="timeline-title">
                                            Track The Crowd: AI Crowd Detection
                                        </h3>
                                        <p class="timeline-org">
                                            CSC490 Capstone w/ Toronto Transit
                                            Commission
                                        </p>
                                        <p class="timeline-desc">
                                            Developing real-time computer vision
                                            system for TTC subway crowd
                                            detection using CNNs and camera
                                            sensors to optimize boarding
                                            efficiency.
                                        </p>
                                        <div class="skills">
                                            <span class="skill-tag"
                                                >Computer Vision</span
                                            >
                                            <span class="skill-tag">CNNs</span>
                                            <span class="skill-tag"
                                                >Real-time Systems</span
                                            >
                                            <span class="skill-tag"
                                                >Public Transit</span
                                            >
                                        </div>
                                    </div>
                                </div>

                                <div class="timeline-item">
                                    <div class="timeline-dot"></div>
