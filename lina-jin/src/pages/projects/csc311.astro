---
import "../../styles/global.css";
import "@fontsource/instrument-serif";
import "@fontsource-variable/noto-serif-kr";
import "@fontsource-variable/instrument-sans";
import "@fontsource/im-fell-great-primer/400-italic.css";
import "@fontsource/im-fell-great-primer";
import file from "../../assets/projects/csc311-final.pdf";
import Navbar from "../../components/Navbar.astro";
---

<meta charset="UTF-8" />
<head>
    <link rel="icon" href="../../assets/logo.svg" type="image/svg+xml" />
</head>
<body class="bg-offwhite">
    <Navbar />
    <main class="ml-20 mr-20 bg-offwhite">
        <div>
            <div class="im-fell-italic bold text-6xl pt-10">
                Food Prediction Final Project
            </div>
            <div class="text-2xl pt-4 im-fell-italic">
                Tools used: spaCy, NLTK, Hugging Face transformers, YouTube API, DeepL API
            </div>
            <div class="text-xl pt-4 pb-4 im-fell">
                This is my final project for AMS312, a course on the theory and application of machine learning. The project explores the use of machine learning techniques to analyze and predict outcomes in various datasets.
            </div>
            
        </div>
        <embed 
        src={file}
        type="application/pdf"
        class="w-full h-screen"
        />
    </main>
</body>
